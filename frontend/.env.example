# Address of the Convex backend's API port (CONVEX_CLOUD_ORIGIN), no trailing slash.
VITE_CONVEX_URL=http://127.0.0.1:3210
# Address of the CMS, no trailing slash. Only this address may show the site in
# its "Site text" preview and send it unpublished text (defaults to
# http://localhost:5173 in development).
VITE_CMS_URL=http://localhost:5173
# Optional, for hosting on Vercel: the backend's site address (CONVEX_SITE_URL,
# the one serving /img/...). Content and pictures are then loaded through this
# site and cached by Vercel's CDN (see vercel.ts). Leave empty in development.
VITE_CONVEX_SITE_URL=
