# --- docker-compose.yml (copy to .env on the server) -------------------------
# Public addresses of the backend's two ports. Put HTTPS in front of both in
# production, e.g. https://api.example.com -> :3210, https://files.example.com -> :3211.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
# Pin a release (see ghcr.io/get-convex/convex-backend) instead of "latest" in production.
CONVEX_IMAGE_TAG=latest
# PORT=3210
# SITE_PROXY_PORT=3211
# DASHBOARD_PORT=6791

# --- Convex CLI (copy to .env.local wherever you run `npx convex ...`) -------
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=   # from: docker compose exec backend ./generate_admin_key.sh

# --- Deployment variables -----------------------------------------------------
# These are NOT read from a file: set them on the deployment with
# `npx convex env set NAME value` (see README.md).
#   MUX_TOKEN_ID, MUX_TOKEN_SECRET   Mux API token, for background video uploads
#   JWT_PRIVATE_KEY, JWKS, SITE_URL  CMS sign-in; set by scripts/setup-auth-keys.mjs
#   AI_SETTINGS_KEY                  Encrypts AI provider keys (see docs/ai-agent.md)
#   GITHUB_TOKEN, GITHUB_REPO        AI Assistant code changes; GITHUB_BRANCH optional
